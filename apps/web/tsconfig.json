{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "jsx": "react-jsx",
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@exam-matrix/shared": [
                "../../packages/shared/src/index.ts"
            ],
            "@exam-matrix/export": [
                "../../packages/export/src/index.ts"
            ],
            "@exam-matrix/rag": [
                "../../packages/rag/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}